# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# NodeJS files
node_modules

# CDK files
cdk.out
/cdk/cache/*
!/cdk/cache/.keep

# Bedrock Agentcore
# The config file for the agentcore starter kit is very specific to the
# local environment
.bedrock_agentcore.yaml

# AgentCore CLI local state, generated per developer by cdk-deploy.sh
services/*/agentcore/cdk-outputs.json

# Individual env vars
.env
.env*
!.env.example

# Virtual environments
.venv
