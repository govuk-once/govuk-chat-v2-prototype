# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# NodeJS files
node_modules

# CDK files
cdk.out
/cdk/cache/*
!/cdk/cache/.keep

# AgentCore CLI local state, generated per developer by cdk-deploy.sh and
# the local development tooling
services/*/agentcore/.cli/
services/*/agentcore/.cache/
services/*/agentcore/cdk-outputs.json
services/*/agentcore/aws-targets.json

# Individual env vars
.env
.env*
!.env.example

# Virtual environments
.venv
